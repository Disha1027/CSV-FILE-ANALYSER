# Copy to secrets.toml and replace placeholders with your own values.
# Keep secrets.toml private; it is excluded by .gitignore.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-cookie-secret"
client_id = "replace-with-your-google-oauth-client-id"
client_secret = "replace-with-your-google-oauth-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[activity]
admin_emails = ["owner@example.com"]
